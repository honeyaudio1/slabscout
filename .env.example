# Card scanning (photo -> card + set)
ANTHROPIC_API_KEY=

# Real eBay sold listings (requires Marketplace Insights API access)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Real graded + ungraded values (paid PriceCharting API subscription; licensed for personal/internal use)
PRICECHARTING_TOKEN=

# Password-reset emails (without these, reset links are saved to data/password-reset-links.txt)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public address of the app, used in reset links
APP_URL=
